default_platform(:android)

desc "Create and sign a new build"
lane :build do
    gradle(tasks: ["clean", "assembleRelease", "bundleRelease"])
end

desc "Submit a new internal build to the Google Play store"
lane :internal do
    upload_to_play_store(
        track: 'internal',
        aab: 'app/build/outputs/bundle/release/app-release.aab',
        release_status: 'draft',
        json_key: '.secure_files/play-store-credentials.json'
    )
end

desc "Submit a new Production build to the Google Play store"
lane :release do
    upload_to_play_store(
        track: 'production',
        aab: 'app/build/outputs/bundle/release/app-release.aab',
        json_key: '.secure_files/play-store-credentials.json'
    )
end
