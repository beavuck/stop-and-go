default_platform(:android)

desc "Create and sign a new build"
lane :build do
    gradle(task: "clean assembleRelease bundleRelease")
end

desc "Submit a new internal build to the Google Play store"
lane :internal do
    upload_to_play_store(
        package_name: 'com.beavuck.stop_and_go',
        track: 'internal',
        aab: 'app/build/outputs/bundle/release/app-release.aab',
        mapping_paths: [
            'app/build/outputs/mapping/release/mapping.txt',
            'app/build/outputs/native-debug-symbols/release/native-debug-symbols.zip'
        ],
        release_status: 'draft',
        json_key: '.secure_files/play-store-credentials.json'
    )
end

desc "Submit a new Production build to the Google Play store"
lane :release do
    upload_to_play_store(
        package_name: 'com.beavuck.stop_and_go',
        track: 'production',
        aab: 'app/build/outputs/bundle/release/app-release.aab',
        mapping_paths: [
            'app/build/outputs/mapping/release/mapping.txt',
            'app/build/outputs/native-debug-symbols/release/native-debug-symbols.zip'
        ],
        json_key: '.secure_files/play-store-credentials.json'
    )
end
